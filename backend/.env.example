# ── LLM ─────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Databases ────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://postgres:password@postgres:5432/opspilot
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Auth ─────────────────────────────────────────────────
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth / MCP
# If the user signs in with GitHub, the app can use the encrypted OAuth token.
# Keep GITHUB_TOKEN as a fallback for local/system-level repo scanning.
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_TOKEN=ghp_...

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Secret encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRETS_KEY=

# Terraform MCP / Terraform Cloud
TERRAFORM_CLOUD_TOKEN=
TERRAFORM_WORKSPACE=

# ── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000


ENABLE_PII_SCRUBBING=false